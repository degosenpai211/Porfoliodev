---
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
---

<Layout
  title="CV — Diego Sarmiento"
  description="Currículum de Diego Sarmiento: sistemas a medida para talleres y lectura de números de un negocio."
>
  <main class="px-4 py-24">
    <SectionContainer>
      <div class="flex flex-wrap items-start justify-between gap-4 print:hidden">
        <div>
          <h1 class="text-3xl font-bold text-gray-800 dark:text-white">Diego Sarmiento</h1>
          <p class="mt-2 text-gray-600 dark:text-gray-300">
            Backend y analista de datos · Santa Cruz de la Sierra, Bolivia
          </p>
        </div>
        <button
          id="print-cv"
          class="rounded-xl border border-gray-300 bg-gray-100 px-4 py-2 text-sm text-gray-800 dark:border-gray-600 dark:bg-gray-800 dark:text-white"
        >
          Guardar como PDF
        </button>
      </div>

      <p class="mt-6 text-gray-700 dark:text-gray-300 print:mt-0">
        Estudiante de Ingeniería en Sistemas. Diseño APIs con FastAPI y
        PostgreSQL y traduzco operación de un negocio a SQL, KPIs y
        recomendaciones. Disponible para trabajar.
      </p>

      <ul class="mt-4 space-y-1 text-sm text-gray-600 dark:text-gray-400">
        <li>Santa Cruz de la Sierra, Bolivia</li>
        <li>
          <a class="hover:underline" href="mailto:diegoarmandosarmientoosinaga@gmail.com">diegoarmandosarmientoosinaga@gmail.com</a>
        </li>
        <li>
          <a class="hover:underline" href="https://github.com/degosenpai211">github.com/degosenpai211</a>
          ·
          <a class="hover:underline" href="https://www.linkedin.com/in/diego-a-sarmiento-osinaga-425980344">LinkedIn</a>
        </li>
      </ul>

      <section class="mt-10">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white">Experiencia</h2>
        <article class="mt-4">
          <h3 class="font-medium text-gray-800 dark:text-white">Backend y datos — ERP Vehimac</h3>
          <p class="text-sm text-gray-500">2026 — Actualidad · Taller mecánico / impresión 3D</p>
          <ul class="mt-2 list-disc pl-5 text-gray-700 dark:text-gray-300">
            <li>API FastAPI + PostgreSQL: órdenes, proformas, salarios y estado de resultados.</li>
            <li>16 migraciones SQL, Kanban sin N+1, deploy en Railway y Vercel.</li>
            <li>KPIs de margen, conversión de proforma y piezas sin recoger.</li>
          </ul>
        </article>
        <article class="mt-6">
          <h3 class="font-medium text-gray-800 dark:text-white">Productos y hackathones</h3>
          <p class="text-sm text-gray-500">2025 — 2026 · Yachay, Innovahack, OdiseIA</p>
          <ul class="mt-2 list-disc pl-5 text-gray-700 dark:text-gray-300">
            <li>Yachay: FastAPI, webhooks de Telegram, SQLite/Postgres y OpenAPI.</li>
            <li>Prototipos para Mobicorp (Innovahack) y competencia OdiseIA.</li>
          </ul>
        </article>
      </section>

      <section class="mt-10">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white">Formación</h2>
        <p class="mt-3 text-gray-700 dark:text-gray-300">
          Ingeniería en Sistemas · 2023 — Actualidad · Santa Cruz de la Sierra, Bolivia
        </p>
      </section>

      <section class="mt-10">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white">Skills</h2>
        <p class="mt-3 text-gray-700 dark:text-gray-300">
          Python, FastAPI, PostgreSQL, SQL, React, JavaScript, Git, Railway, Vercel.
          Práctica: PHP, Laravel, contenedores.
        </p>
      </section>

      <section class="mt-10">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-white">Proyectos</h2>
        <ul class="mt-3 list-disc pl-5 text-gray-700 dark:text-gray-300">
          <li>Vehimac — ERP en producción (FastAPI, Postgres, /docs).</li>
          <li>Análisis de operación de taller — SQL, dashboard y recomendaciones.</li>
          <li>Yachay — tutor escolar por API y dashboard docente.</li>
        </ul>
      </section>
    </SectionContainer>
  </main>
</Layout>

<script>
  document.getElementById("print-cv")?.addEventListener("click", () => {
    window.print()
  })
</script>

<style>
  @media print {
    header,
    footer,
    #print-cv {
      display: none !important;
    }
    body {
      background: white !important;
      color: black !important;
    }
  }
</style>
