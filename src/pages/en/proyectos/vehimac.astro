---
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import CaseHeader from "@/components/CaseHeader.astro"
import VehimacSketches from "@/components/VehimacSketches.astro"
---

<Layout
  title="Vehimac — a system for a workshop | Diego Sarmiento"
  description="How a workshop moved from Excel and WhatsApp to its own system for jobs, quotes and the month. One of two workshops I have worked with."
>
  <main class="px-4 py-24">
    <SectionContainer>
      <CaseHeader
        kicker="Custom system · workshop"
        title="Vehimac — a workshop that left loose spreadsheets"
        summary="I have worked with two workshops. One of them is Vehimac: auto repair and 3D printing in Santa Cruz. Day to day lived in Excel, WhatsApp and notes. I built a system so the job, the quote and the month live in one place."
      />

      <section class="mt-14 space-y-4 text-gray-700 dark:text-gray-300">
        <h2 class="text-2xl font-semibold text-gray-800 dark:text-white">The problem</h2>
        <p>
          They quoted over WhatsApp, logged the job in spreadsheets and then
          could not tell which part was ready, which one the customer had not
          picked up, and whether the month was closing well. Every question
          meant opening chats and Excel again.
        </p>
      </section>

      <section class="mt-12 space-y-4 text-gray-700 dark:text-gray-300">
        <h2 class="text-2xl font-semibold text-gray-800 dark:text-white">What it solves</h2>
        <p>
          A system that belongs to the shop: they enter the customer, follow
          the job and build the quote without rewriting it. The owner sees
          progress and how the period is doing, without assembling the report
          by hand.
        </p>
      </section>

      <VehimacSketches />

      <section class="mt-12 space-y-4 text-gray-700 dark:text-gray-300">
        <h2 class="text-2xl font-semibold text-gray-800 dark:text-white">How it is built</h2>
        <p>
          You do not need to code to see the pieces. The shop uses a screen.
          Behind it, a program receives what they enter and stores it in
          order. Customers, jobs and payments stay together, not split across
          files.
        </p>
        <div class="grid gap-3 text-sm sm:grid-cols-3">
          {
            [
              ["The screen", "They see jobs, quotes and how the month is going."],
              ["The program behind it", "It receives what they enter and keeps it consistent."],
              ["The information", "Customers, jobs and payments in one place."],
            ].map(([name, detail]) => (
              <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
                <p class="font-semibold text-gray-800 dark:text-white">{name}</p>
                <p class="mt-1 text-gray-600 dark:text-gray-400">{detail}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-12 space-y-4 text-gray-700 dark:text-gray-300">
        <h2 class="text-2xl font-semibold text-gray-800 dark:text-white">What changed</h2>
        <ul class="list-disc space-y-2 pl-5">
          <li>Each job has a status. “It is ready” is no longer mixed with “the customer already picked it up”.</li>
          <li>The quote comes from the same system and can be sent on WhatsApp, without copying numbers by hand.</li>
          <li>The period result shows on screen. Before, someone rebuilt it in the spreadsheet.</li>
          <li>The shop checks one place instead of chats, photos and Excel for the same job.</li>
        </ul>
      </section>
    </SectionContainer>
  </main>
</Layout>
