---
import ThemeToggle from "./ThemeToggle.astro"
import { getLang, localize, alternatePath } from "@/i18n"

const lang = getLang(Astro.url)

const TITLES = {
  es: ["Experiencia", "Proyectos", "Skills", "Sobre mí", "CV", "Contacto"],
  en: ["Experience", "Projects", "Skills", "About", "CV", "Contact"],
}[lang]

const navItems = [
  { label: "experiencia", url: localize(lang, "/#experiencia") },
  { label: "proyectos", url: localize(lang, "/#proyectos") },
  { label: "skills", url: localize(lang, "/#skills") },
  { label: "sobre-mi", url: localize(lang, "/#sobre-mi") },
  { label: "cv", url: localize(lang, "/cv") },
  { label: "contacto", url: "mailto:diegoarmandosarmientoosinaga@gmail.com" },
].map((item, i) => ({ ...item, title: TITLES[i] }))

const switchLang = {
  title: lang === "en" ? "ES" : "EN",
  url: alternatePath(Astro.url),
  hint: lang === "en" ? "Ver en español" : "View in English",
}
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-2 text-xs font-medium rounded-full text-gray-600 dark:text-gray-200 justify-center items-center whitespace-nowrap sm:px-3 sm:text-sm"
  >
    {
      navItems.map((link) => (
        <a
          class:list={[
            "relative px-1.5 py-2 transition hover:text-blue-500 dark:hover:text-blue-500 sm:px-2",
            link.label === "contacto" ? "hidden sm:block" : "block",
          ]}
          data-section={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <a
      class="relative block px-1.5 py-2 font-semibold transition hover:text-blue-500 dark:hover:text-blue-500 sm:px-2"
      href={switchLang.url}
      hreflang={lang === "en" ? "es" : "en"}
      title={switchLang.hint}
      aria-label={switchLang.hint}
    >
      {switchLang.title}
    </a>
    <ThemeToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a")

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("data-section") == entry.target.id) {
              item.classList.add("text-blue-500")
            } else {
              item.classList.remove("text-blue-500")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  @reference "../styles/global.css";

  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply dark:bg-gray-800/90 bg-white/50;
  }

  @keyframes nav-shadown {
    0% {
      background-color: transparent;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur-sm ring-white/10;
    }
  }
</style>
