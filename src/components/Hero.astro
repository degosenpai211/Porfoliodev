---
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import GitHub from "@/components/icons/GitHub.astro"
import FileIcon from "@/components/icons/File.astro"
import SocialPill from "@/components/SocialPill.astro"
import { getLang, localize } from "@/i18n"

const lang = getLang(Astro.url)
const en = lang === "en"
const pricesHref = "https://ofertas-web-diego.netlify.app/"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      src="/diego-128.webp"
      width="64"
      height="64"
      alt="Diego Sarmiento"
      class="rounded-full shadow-lg size-16 object-cover object-[center_18%]"
    />
    <a
      href="https://www.linkedin.com/in/diego-a-sarmiento-osinaga-425980344"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>{en ? "Open to work" : "Disponible para trabajar"}</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    {en ? "Hey, I'm Diego Sarmiento" : "Hey, soy Diego Sarmiento"}
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&_strong]:text-yellow-200 [&_strong]:text-yellow-500 [&_strong]:font-semibold dark:text-gray-300"
  >
    {
      en ? (
        <Fragment>
          Systems Engineering student in Santa Cruz de la Sierra, Bolivia.
          If you are looking for a way to organize or improve your business,
          <strong> custom software gets you there</strong>: one place for the
          work, the quote and how the month is going. I have already done this
          with <strong>two workshops</strong>.
        </Fragment>
      ) : (
        <Fragment>
          Estudiante de Ingeniería en Sistemas en Santa Cruz de la Sierra, Bolivia.
          Si buscás ordenar o mejorar tu negocio,
          <strong> un software a medida lo consigue</strong>: un solo lugar para
          el trabajo, la cotización y cómo va el mes. Ya lo hice con
          <strong> dos talleres</strong>.
        </Fragment>
      )
    }
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href={pricesHref}>
      {en ? "Prices and packs" : "Precios y packs"}
    </SocialPill>
    <SocialPill href="mailto:diegoarmandosarmientoosinaga@gmail.com">
      <MailIcon class="size-4" />
      {en ? "Contact me" : "Contáctame"}
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/diego-a-sarmiento-osinaga-425980344">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/degosenpai211">
      <GitHub class="size-4" />
      GitHub
    </SocialPill>
    <SocialPill href={localize(lang, "/cv")}>
      <FileIcon class="size-4" />
      CV
    </SocialPill>
  </nav>
</div>
