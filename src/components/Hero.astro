---
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import GitHub from "@/components/icons/GitHub.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      src="/me.png"
      alt="Diego Sarmiento"
      class="rounded-full shadow-lg size-16 object-cover"
    />
    <a
      href="https://www.linkedin.com/in/diego-a-sarmiento-osinaga-425980344"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, soy Diego Sarmiento
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    Estudiante de Ingeniería en Sistemas desde 2023 en Santa Cruz de la Sierra,
    Bolivia. <strong>Programador en React, JavaScript, PHP, Laravel, bases de
    datos y contenedores</strong>; actualmente aprendiendo Astro y construyendo
    proyectos personales para crecer como desarrollador Fullstack.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:diegoarmandosarmientoosinaga@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/diego-a-sarmiento-osinaga-425980344">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
