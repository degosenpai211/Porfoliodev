---
import ExperienceItem from "./ExperienceItem.astro"
import { getLang, localize } from "@/i18n"

const ES = [
  {
    date: "2026 — Actualidad",
    title: "Sistemas para talleres",
    company: "Dos talleres · uno de ellos, Vehimac",
    description:
      "Sistema a medida para seguir trabajos, cotizar y ver cómo va el mes. Vehimac dejó el Excel y el WhatsApp suelto. El detalle del caso no publica el sistema ni sus datos.",
    link: "/proyectos/vehimac",
  },
  {
    date: "2025 — 2026",
    title: "Hackathones y productos propios",
    company: "Yachay, Innovahack, OdiseIA",
    description:
      "APIs con webhooks, SQLite/Postgres y dashboards. Yachay es un tutor escolar por Telegram con FastAPI y docs OpenAPI. También presenté prototipos en Innovahack (Mobicorp) y OdiseIA.",
    link: "/proyectos/yachay",
  },
  {
    date: "2023 — Actualidad",
    title: "Estudiante de Ingeniería en Sistemas",
    company: "Santa Cruz de la Sierra, Bolivia",
    description:
      "Fundamentos de programación y de cómo se organiza la información de un negocio. El trabajo con talleres es donde eso se vuelve una herramienta que el dueño puede usar.",
  },
]

const EN = [
  {
    date: "2026 — Present",
    title: "Systems for workshops",
    company: "Two workshops · one of them, Vehimac",
    description:
      "Custom software to follow jobs, quote and see how the month is going. Vehimac left loose Excel and WhatsApp. The case write-up does not publish the system or its data.",
    link: "/proyectos/vehimac",
  },
  {
    date: "2025 — 2026",
    title: "Hackathons and own products",
    company: "Yachay, Innovahack, OdiseIA",
    description:
      "APIs with webhooks, SQLite/Postgres and dashboards. Yachay is a school tutor over Telegram built with FastAPI and OpenAPI docs. I also presented prototypes at Innovahack (Mobicorp) and OdiseIA.",
    link: "/proyectos/yachay",
  },
  {
    date: "2023 — Present",
    title: "Systems Engineering student",
    company: "Santa Cruz de la Sierra, Bolivia",
    description:
      "Programming fundamentals and how a business keeps its information. Workshop work is where that becomes a tool the owner can actually use.",
  },
]

const lang = getLang(Astro.url)
const EXPERIENCE = (lang === "en" ? EN : ES).map((item) => ({
  ...item,
  link: item.link && localize(lang, item.link),
  linkLabel: lang === "en" ? "Learn more" : "Saber más",
}))
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li>
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
