---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCE = [
  {
    date: "2023 - Actualidad",
    title: "Estudiante de Ingeniería en Sistemas",
    company: "Santa Cruz de la Sierra, Bolivia",
    description:
      "Cursando la carrera desde 2023 con foco en fundamentos de programación, estructuras de datos y arquitectura de software mientras desarrollo proyectos de práctica.",
  },
  {
    date: "2024 - Actualidad",
    title: "Proyectos personales y autoaprendizaje",
    company: "Stack: React, JavaScript, PHP, Laravel, BD, contenedores",
    description:
      "He desarrollado proyectos web, participado en hackathones y completado cursos de desarrollo, aplicando tecnologías modernas. Me gusta crear soluciones funcionales que tengan buena escalabilidad y buena estructura por medio del aprendizaje continuo. ",
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
